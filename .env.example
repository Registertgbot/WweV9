# Telegram bot token from @BotFather
BOT_TOKEN=
# Railway provides this when you add a PostgreSQL service (postgres:// and postgresql:// are both accepted)
DATABASE_URL=
# Your numeric Telegram ID (send /id to the bot to find it)
OWNER_ID=

CHALLENGE_TIMEOUT_SECONDS=60
TURN_TIMEOUT_SECONDS=60
REVERSAL_TIMEOUT_SECONDS=15
# pause | cancel | forfeit
TIMEOUT_POLICY=pause

# Optional
DM_SETUP_TIMEOUT_SECONDS=300
PAUSE_EXPIRY_SECONDS=86400
RESTART_GRACE_SECONDS=30
# false = the defender is only told "an attack is incoming" (hidden-information mode)
REVEAL_INCOMING_MOVE=false
LOG_LEVEL=INFO

# Optional: mirror tournament results to a channel (bot must be a channel admin). -100... id or @username. Test with /channeltest
RESULTS_CHANNEL_ID=

# Groups where the bot always works (comma separated). Every other group needs the owner to send /allow there.
DEFAULT_GROUP_ID=
